{
  "name": "el-rival-mas-debil",
  "version": "2.0.0",
  "private": true,
  "description": "Trivia multijugador por salas con React, Vite y Supabase",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:questions": "node scripts/validate-questions.mjs",
    "validate:questions:final": "node scripts/validate-questions.mjs --final data/questions/cultura-general.json data/questions/videojuegos.json data/questions/series-90.json",
    "validate:general-5000": "node scripts/validate-general-5000.mjs --final",
    "merge:general-5000": "node scripts/merge-general-5000.mjs",
    "audit:ambiguity": "node scripts/audit-ambiguity.mjs",
    "merge:context-fixes": "node scripts/merge-context-fixes.mjs",
    "merge:questions": "node scripts/merge-questions.mjs",
    "seed:questions": "node scripts/seed-questions.mjs",
    "serve:questions": "node scripts/serve-questions.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:room-close": "node scripts/close-room-test.mjs",
    "test:realtime": "node scripts/realtime-test.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:e2e:race": "node scripts/e2e-race-test.mjs",
    "test:e2e:social": "node scripts/e2e-social-test.mjs",
    "test:e2e:close-room": "node scripts/e2e-close-room-test.mjs",
    "test:items": "node scripts/items-api-test.mjs",
    "test:e2e:items": "node scripts/e2e-items-test.mjs",
    "test:mobile": "node scripts/mobile-audit.mjs",
    "test:mobile:voting": "node scripts/mobile-voting-audit.mjs",
    "test:mobile:invite": "node scripts/mobile-invite-audit.mjs",
    "test:lobby-card": "node scripts/lobby-card-test.mjs",
    "test:chat": "node scripts/chat-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
